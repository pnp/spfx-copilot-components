{
  "name": "zava-customer-resolution-center",
  "version": "0.0.2",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "npm run configure:intents && npm run validate && heft test --clean --production && heft package-solution --production && npm run check:generated-plugin && npm run check:package-output && npm run generate:release-evidence && npm run check:release-evidence",
    "configure:intents": "node scripts/configure-intent-components.mjs",
    "check:intents": "node scripts/validate-intent-components.mjs",
    "check:react": "node scripts/validate-react-baseline.mjs",
    "check:media": "node scripts/validate-media-provenance.mjs",
    "generate:routing-matrix": "node scripts/generate-routing-matrix.mjs",
    "check:routing-matrix": "node scripts/generate-routing-matrix.mjs --check",
    "check:routing-collisions": "node scripts/validate-routing-collisions.mjs",
    "check:gallery": "node scripts/validate-gallery-assets.mjs",
    "check:publication": "node scripts/validate-publication-assets.mjs",
    "check:generated-plugin": "node scripts/validate-generated-ai-plugin.mjs",
    "check:package-output": "node scripts/validate-package-output.mjs",
    "generate:release-evidence": "node scripts/generate-release-evidence.mjs",
    "check:release-evidence": "node scripts/generate-release-evidence.mjs --check",
    "capture:visual": "node scripts/capture-gallery-assets.mjs",
    "check:flagship-inline": "node scripts/validate-flagship-inline.mjs",
    "validate": "npm run check:intents && npm run check:react && npm run check:routing-matrix && npm run check:routing-collisions && npm run check:media && npm run check:gallery && npm run check:publication && npm run check:flagship-inline && heft test --clean",
    "test": "heft test --clean",
    "build:visual": "node scripts/build-visual-harness.mjs",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "heft start --clean"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.6",
    "@fluentui/react-icons": "2.0.314",
    "@griffel/react": "1.7.7",
    "@microsoft/sp-copilot-component": "1.24.0",
    "@microsoft/sp-http": "1.24.0",
    "@microsoft/sp-lodash-subset": "1.24.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "topojson-client": "3.1.0",
    "tslib": "2.3.1",
    "world-atlas": "2.0.2",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0",
    "@microsoft/eslint-plugin-spfx": "1.24.0",
    "@microsoft/spfx-heft-plugins": "1.24.0",
    "@microsoft/spfx-web-build-rig": "1.24.0",
    "@rushstack/heft": "1.3.2",
    "@types/d3-array": "3.2.1",
    "@types/d3-geo": "3.1.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.10",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/topojson-client": "3.1.5",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "esbuild": "0.25.9",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.55.0",
    "typescript": "~5.8.0",
    "unzipper": "0.12.3"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "uri-js": "4.4.1",
    "uuid": ">=11.1.1"
  },
  "resolutions": {
    "@types/react": "18.3.31"
  }
}
