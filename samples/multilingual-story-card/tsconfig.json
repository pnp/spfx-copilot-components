{
  "extends": "./node_modules/@microsoft/spfx-web-build-rig/profiles/default/tsconfig-base.json",
  "compilerOptions": {
    // Rig defaults plus the typings for the Intl APIs the card relies on (Locale, DisplayNames,
    // Segmenter, unit formatting) and String.trimEnd. All are feature-detected at runtime; the
    // Copilot hosts (Edge WebView2, Chromium, Safari) ship them.
    "lib": [
      "dom",
      "es5",
      "es2015.core",
      "es2015.collection",
      "es2015.iterable",
      "es2015.promise",
      "es2015.proxy",
      "es2016.intl",
      "es2019.string",
      "es2020.intl",
      "es2021.intl",
      "es2022.intl"
    ],
    // Tests run on Vitest (vitest.config.mts) and are type-checked by tsconfig.test.json.
    "types": ["webpack-env"]
  },
  // Heft compiles, lints and bundles the shipping code only.
  "exclude": ["src/**/*.test.ts", "src/**/testing/**"],
  "watchOptions": {
    // Prevent the TypeScript watch program from re-triggering incremental builds
    // when the copilot-agent task regenerates its outputs (temp/copilot staging
    // and the teams/<agent>.zip package) on every build, which otherwise causes
    // an infinite build loop during `heft start` / `heft build-watch`.
    "excludeDirectories": ["**/teams", "**/temp/copilot"]
  }
}
