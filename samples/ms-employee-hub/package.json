{
  "name": "ms-employee-hub",
  "author": "Contoso",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "node scripts/configure-hosts.mjs --all --check && npm run test:hosts && npm run test:domain && npm run package:spfx && npm run package:teams && node scripts/audit-package.mjs --all",
    "build:proof": "node scripts/configure-hosts.mjs --check && npm run test:hosts && npm run package:spfx && npm run package:teams && node scripts/audit-package.mjs",
    "package:spfx": "heft test --clean --production && heft package-solution --production",
    "package:teams": "node scripts/package-teams.mjs && node scripts/package-teams.mjs --check",
    "package:pilot": "node scripts/package-pilot.mjs",
    "package:cowork": "node scripts/package-cowork.mjs --review",
    "test:hosts": "node --test scripts/host*.test.cjs",
    "test:domain": "node --test tests/*.test.mjs tests/*.test.cjs",
    "generate:hosts": "node scripts/generate-hosts.mjs",
    "generate:icons": "node scripts/generate-identity-art.mjs",
    "review:build": "node scripts/review.mjs --build",
    "review": "node scripts/review.mjs",
    "review:check": "node scripts/review-check.mjs",
    "review:candidate": "npm run review:check && npm run build && node --test scripts/cowork-package.test.mjs scripts/teams-package.test.mjs && npm run package:cowork && node scripts/audit-package.mjs --all --cowork && node scripts/check-compiled.cjs && node scripts/audit-review.mjs && node scripts/release-docs.mjs && node scripts/release-docs.mjs --check",
    "review:film": "node scripts/review-film.mjs",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "start": "heft start --clean"
  },
  "dependencies": {
    "@griffel/react": "1.7.8",
    "tslib": "2.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-copilot-component": "1.24.2",
    "@microsoft/sp-lodash-subset": "1.24.2",
    "zod": "4.6.7",
    "@fluentui/react-components": "^9.70.0",
    "@fluentui/react-icons": "2.0.314",
    "@microsoft/sp-http": "1.24.2",
    "@microsoft/sp-core-library": "1.24.2",
    "@microsoft/sp-component-base": "1.24.2",
    "@microsoft/sp-property-pane": "1.24.2",
    "@microsoft/sp-webpart-base": "1.24.2",
    "@microsoft/sp-office-ui-fabric-core": "1.24.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.65.0",
    "postcss": "8.5.33",
    "postcss-modules-local-by-default": "4.2.0",
    "sass-embedded": "1.85.1",
    "jszip": "3.10.1",
    "jsdom": "26.1.0",
    "@microsoft/eslint-plugin-spfx": "1.24.2",
    "@microsoft/eslint-config-spfx": "1.24.2",
    "@microsoft/spfx-web-build-rig": "1.24.2",
    "@microsoft/spfx-heft-plugins": "1.24.2",
    "@rushstack/heft": "1.3.2",
    "@types/jest": "30.0.0",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "typescript": "~5.8.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "eslint-plugin-react-hooks": "5.2.0",
    "@microsoft/sp-module-interfaces": "1.24.2"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "serialize-javascript": "^7.1.3",
    "uuid": ">=11.1.1"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  }
}
