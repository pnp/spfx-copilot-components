{
  "name": "zava-employee-agent",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "npm run check:mock-media && npm run check:gallery && heft test --clean --production && heft package-solution --production && npm run check:generated-plugin && npm run check:package-output",
    "check:gallery": "node scripts/validate-gallery-assets.mjs",
    "check:generated-plugin": "node scripts/validate-generated-ai-plugin.mjs",
    "check:mock-media": "node scripts/generate-embedded-images.mjs --check",
    "check:package-output": "node scripts/validate-package-output.mjs",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "generate:mock-media": "node scripts/generate-embedded-images.mjs",
    "start": "heft start --clean",
    "start:ux-review": "node scripts/serve-ux-review.mjs"
  },
  "dependencies": {
    "@fluentui/react-avatar": "9.11.3",
    "@fluentui/react-components": "9.54.0",
    "@fluentui/react-icons": "2.0.270",
    "@fluentui/react-motion": "9.16.1",
    "@fluentui/react-provider": "9.22.18",
    "@fluentui/react-text": "9.6.18",
    "@fluentui/react-theme": "9.2.1",
    "@griffel/react": "1.7.7",
    "@microsoft/sp-copilot-component": "1.24.0",
    "@microsoft/sp-lodash-subset": "1.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0",
    "@microsoft/eslint-plugin-spfx": "1.24.0",
    "@microsoft/spfx-heft-plugins": "1.24.0",
    "@microsoft/spfx-web-build-rig": "1.24.0",
    "@rushstack/heft": "1.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "esbuild": "0.25.9",
    "eslint": "9.37.0",
    "typescript": "~5.8.0",
    "unzipper": "0.12.3"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2"
  },
  "resolutions": {
    "@types/react": "18.3.31"
  }
}
