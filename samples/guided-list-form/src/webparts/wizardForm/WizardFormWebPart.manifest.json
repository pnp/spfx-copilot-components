{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "c111bb1f-5e2a-4d43-9b8e-6f0a7a3c2d41",
  "alias": "WizardFormWebPart",
  "componentType": "WebPart",

  // The "*" signifies that the version should be taken from the package.json
  "version": "*",
  "manifestVersion": 2,

  // No custom script, no API permissions: SharePoint REST as the signed-in user only.
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart"],
  "supportsThemeVariants": true,

  "preconfiguredEntries": [{
    "groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
    "group": { "default": "Advanced" },
    "title": { "default": "Guided Form" },
    "description": { "default": "A conversational, one-question-at-a-time form for SharePoint lists." },
    "iconImageUrl": "data:image/svg+xml;base64,",
    "properties": {
      "siteUrl": "",
      "listName": "",
      "fields": "",
      "formTitle": "",
      "introText": "",
      "thankYouText": "Thanks, your answers were submitted.",
      "showReview": true,
      "animations": true,
      "accentColor": "",
      "highlightColor": "",
      "loadingMessage": "",
      "answerChecks": ""
    }
  }]
}
