{
  "name": "zava-one-hub",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "npm run validate && heft test --clean --production && heft package-solution --production && npm run check:generated-plugin && npm run check:package-output && npm run update:release-evidence && npm run check:release-evidence && npm run check:visual-evidence",
    "build:ux-review": "node scripts/build-ux-review.mjs",
    "capture:publication": "node scripts/capture-publication.mjs",
    "capture:gallery": "node scripts/capture-publication.mjs --gallery",
    "check:generated-plugin": "node scripts/validate-generated-ai-plugin.mjs",
    "check:agent-icons": "node scripts/generate-agent-icons.mjs --check",
    "check:media": "node scripts/validate-media-provenance.mjs && node scripts/generate-embedded-media.mjs --check",
    "check:package-output": "node scripts/validate-package-output.mjs",
    "check:publication": "node scripts/validate-publication.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:teams-apps": "node scripts/validate-teams-apps.mjs",
    "check:react-baseline": "node scripts/validate-react-baseline.mjs",
    "check:reference-hosts": "node --test scripts/generated-text.test.mjs && node scripts/configure-reference-hosts.mjs --check",
    "check:release-evidence": "node scripts/validate-release-evidence.mjs",
    "check:routing-collisions": "node scripts/validate-routing-collisions.mjs",
    "check:visual-evidence": "node scripts/generate-visual-evidence.mjs --check",
    "clean": "heft clean",
    "configure:reference-hosts": "node scripts/configure-reference-hosts.mjs",
    "eject-webpack": "heft eject-webpack",
    "generate:media": "node scripts/generate-embedded-media.mjs",
    "generate:visual-evidence": "node scripts/generate-visual-evidence.mjs",
    "update:release-evidence": "node scripts/update-release-evidence.mjs && node scripts/generate-visual-evidence.mjs",
    "generate:approved-components": "node scripts/generate-approved-components.mjs",
    "generate:agent-icons": "node scripts/generate-agent-icons.mjs",
    "start": "heft start --clean",
    "start:ux-review": "node scripts/serve-ux-review.mjs",
    "validate": "npm run check:reference-hosts && npm run check:react-baseline && npm run check:routing-collisions && npm run check:agent-icons && npm run check:media && npm run check:publication && npm run check:teams-apps && npm run build:ux-review && heft test --clean"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.314",
    "@griffel/react": "1.7.8",
    "@microsoft/sp-component-base": "1.24.0",
    "@microsoft/sp-copilot-component": "1.24.0",
    "@microsoft/sp-core-library": "1.24.0",
    "@microsoft/sp-http": "1.24.0",
    "@microsoft/sp-lodash-subset": "1.24.0",
    "@microsoft/sp-office-ui-fabric-core": "1.24.0",
    "@microsoft/sp-property-pane": "1.24.0",
    "@microsoft/sp-top-actions": "1.24.0",
    "@microsoft/sp-webpart-base": "1.24.0",
    "d3-array": "3.2.4",
    "d3-geo": "3.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "topojson-client": "3.1.0",
    "tslib": "2.3.1",
    "world-atlas": "2.0.2",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.0",
    "@microsoft/eslint-plugin-spfx": "1.24.0",
    "@microsoft/sp-module-interfaces": "1.24.0",
    "@microsoft/spfx-heft-plugins": "1.24.0",
    "@microsoft/spfx-web-build-rig": "1.24.0",
    "@rushstack/heft": "1.3.2",
    "@types/d3-array": "3.2.2",
    "@types/d3-geo": "3.1.1",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/topojson-client": "3.1.5",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "esbuild": "0.25.10",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright": "1.63.0",
    "typescript": "~5.8.0",
    "unzipper": "0.12.3"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "uuid": ">=11.1.1"
  },
  "resolutions": {
    "@types/react": "18.3.31"
  }
}
